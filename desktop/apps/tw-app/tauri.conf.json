{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TraeWork2API",
  "version": "0.1.0",
  "identifier": "com.traework2api.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../../frontend run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../../frontend run build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TraeWork2API",
        "width": 1120,
        "height": 760,
        "minWidth": 920,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8790 ws://localhost:5173 http://localhost:5173; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  }
  ,
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
